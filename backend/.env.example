# Server
PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=orgtraces
DB_PASSWORD=changeme_strong_password
DB_NAME=orgtraces
DB_SSL_MODE=disable
DB_MAX_CONNS=50

# JWT
JWT_SECRET=changeme_jwt_secret_min_32_chars_long
JWT_EXPIRY=24h

# S3-compatible storage (Cloudflare R2 / MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=orgtraces-screenshots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

# Agent
AGENT_API_KEY=changeme_agent_api_key
HEARTBEAT_INTERVAL=30s
SCREENSHOT_MAX_SIZE=5242880
